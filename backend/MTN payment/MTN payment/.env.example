PORT=5000
PAWAPAY_BASE_URL=https://api.pawapay.io
PAWAPAY_TOKEN=replace_with_your_pawapay_token
# Use the same long random value in backend/.env and this file's local .env.
PAYMENT_INTERNAL_KEY=replace_with_a_long_random_shared_secret
# Comma-separated frontend origins permitted to call /api/payment.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
